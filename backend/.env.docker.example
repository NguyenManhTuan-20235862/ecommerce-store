PORT=5000

# Dùng tên service "mongo" (không phải localhost) khi chạy Docker
MONGODB_CONNECTIONSTRING=mongodb://mongo:27017/ecommerceStore

# Tạo secret ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=REPLACE_WITH_YOUR_SECRET_HERE

# Origins được phép gọi API từ nginx
CORS_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
